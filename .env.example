# Public address of the site (with trailing slash): canonical URLs, Open Graph, sitemap.xml
SITE_URL=https://vickand.com/
# Sub-path the site is served from: "/" for a custom domain, "/<repo>/" for a GitHub Pages project site
BASE_PATH=/

# Server-only: add these in Vercel, never prefix them with VITE_ or commit real keys.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Vickand <notifications@vickand.com>
CONTACT_TO_EMAIL=shapeinc25@gmail.com
RESEND_CONTACT_TEMPLATE_ID=
RESEND_WAITLIST_TEMPLATE_ID=

# Support forwarding: separate server-only production credential approved by owner.
# Do not use the sending-only website key for receiving.
RESEND_RECEIVING_API_KEY=
RESEND_RECEIVING_WEBHOOK_SECRET=
